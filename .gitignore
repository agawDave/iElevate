node_modules/
# Learner certificates contain personal data
backend/certificates/
# Files people upload through the app (profile photos, answers, module materials)
backend/uploads/
backend/activity-files/
backend/module-resources/*
# …except the four official ELEVATE training-design PDFs, which every copy of the app needs
!backend/module-resources/elevate-phase-*.pdf
# Python helper environment, not needed to run the app
.venv/
# Stray test file in the project root
/-
.env
.env.local
dist/
build/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.claude/
# Office lock files (made while a Word/PowerPoint/Excel file is open)
~$*
